{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cb8eatswebsite",
  "main": "worker.js",
  "compatibility_date": "2026-08-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // By default a request that matches a static file (like "/" -> index.html)
    // is served straight from the files and never reaches worker.js. Run the
    // Worker first only for the paths listed here:
    //  - "/" so worker.js can show the Dev hub at the root of dev.cb8eats.com
    //    (every other host falls through to ASSETS and gets the home page);
    //  - the dev pages and their data files, so worker.js can keep them off
    //    every hostname except the dev one (the one Cloudflare Access protects).
    // Keep this list in step with DEV_PAGES / DEV_DATA in worker.js.
    "run_worker_first": [
      "/",
      "/dev", "/dev.html",
      "/tracker", "/tracker.html",
      "/coa-tracker", "/coa-tracker.html",
      "/warframe", "/warframe.html",
      "/resource-inventory.json", "/coa-inventory.json", "/warframe-data.json", "/warframe-mod-stats.json", "/warframe-community-builds.json"
    ]
  },
  "vars": {
    // Public/non-secret. The actual send credential is RESEND_API_KEY,
    // set as a Worker secret (never here) — see CLAUDE.md.
    "APPLY_FROM_EMAIL": "noreply@cb8eats.com"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cb8eatswebsite",
  "main": "worker.js",
  "compatibility_date": "2026-08-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // By default a request that matches a static file (like "/" -> index.html)
    // is served straight from the files and never reaches worker.js. Run the
    // Worker first for "/" only, so worker.js can show the Dev hub at the root
    // of dev.cb8eats.com. For every other host it falls through to ASSETS and
    // returns the normal home page.
    "run_worker_first": ["/"]
  },
  "vars": {
    // Public/non-secret. The actual send credential is RESEND_API_KEY,
    // set as a Worker secret (never here) — see CLAUDE.md.
    "APPLY_FROM_EMAIL": "noreply@cb8eats.com"
  }
}
